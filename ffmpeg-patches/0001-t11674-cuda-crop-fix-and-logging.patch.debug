         enc_ctx->width  = frame->width;
         enc_ctx->height = frame->height;
         enc_ctx->sample_aspect_ratio =
diff --git a/libavfilter/vf_overlay_cuda.c b/libavfilter/vf_overlay_cuda.c
index 3d39458f3f..ef606be774 100644
--- a/libavfilter/vf_overlay_cuda.c
+++ b/libavfilter/vf_overlay_cuda.c
@@ -246,6 +246,15 @@ static int overlay_cuda_blend(FFFrameSync *fs)
     if (!input_main)
         return AVERROR_BUG;
 
+    av_log(avctx, AV_LOG_INFO,
+           "T11674 overlay_cuda(pre-writable): main %dx%d crop(t=%u b=%u l=%u r=%u) "
+           "writable=%d [outlink %dx%d] overlay=%s\n",
+           input_main->width, input_main->height,
+           input_main->crop_top, input_main->crop_bottom,
+           input_main->crop_left, input_main->crop_right,
+           av_frame_is_writable(input_main), outlink->w, outlink->h,
+           input_overlay ? "yes" : "no");
+
     if (!input_overlay)
         return ff_filter_frame(outlink, input_main);
 
@@ -255,6 +264,12 @@ static int overlay_cuda_blend(FFFrameSync *fs)
         return ret;
     }
 
+    av_log(avctx, AV_LOG_INFO,
+           "T11674 overlay_cuda(post-writable): main %dx%d crop(t=%u b=%u l=%u r=%u)\n",
+           input_main->width, input_main->height,
+           input_main->crop_top, input_main->crop_bottom,
+           input_main->crop_left, input_main->crop_right);
+
     // push cuda context
 
     ret = CHECK_CU(cu->cuCtxPushCurrent(cuda_ctx));
diff --git a/libavfilter/vf_scale_cuda.c b/libavfilter/vf_scale_cuda.c
index 5fd757161b..58e49082e0 100644
--- a/libavfilter/vf_scale_cuda.c
+++ b/libavfilter/vf_scale_cuda.c
@@ -579,6 +579,15 @@ static int cudascale_scale(AVFilterContext *ctx, AVFrame *out, AVFrame *in)
                                            AV_SIDE_DATA_PROP_SIZE_DEPENDENT);
     }
 
+    av_log(ctx, AV_LOG_INFO,
+           "T11674 scale_cuda: in %dx%d crop(t=%u b=%u l=%u r=%u) -> "
+           "out %dx%d crop(t=%u b=%u l=%u r=%u) [outlink %dx%d]\n",
+           in->width, in->height,
+           in->crop_top, in->crop_bottom, in->crop_left, in->crop_right,
+           out->width, out->height,
+           out->crop_top, out->crop_bottom, out->crop_left, out->crop_right,
+           outlink->w, outlink->h);
+
     return 0;
 }
 
diff --git a/libavfilter/video.c b/libavfilter/video.c
index 3f23a12c07..a3539d03f7 100644
--- a/libavfilter/video.c
+++ b/libavfilter/video.c
@@ -64,8 +64,22 @@ AVFrame *ff_default_get_video_buffer2(AVFilterLink *link, int w, int h, int alig
             return NULL;
 
         ret = av_hwframe_get_buffer(li->l.hw_frames_ctx, frame, 0);
-        if (ret < 0)
+        if (ret < 0) {
             av_frame_free(&frame);
+            return frame;
+        }
+
+        /* av_hwframe_get_buffer() sizes the frame to the (possibly alignment-
+         * padded) surface dimensions of the frames context. Honor the caller's
+         * requested logical dimensions instead, matching the software path and
+         * avoiding e.g. a 1080-line request being handed back as 1088 lines. */
+        av_log(link->dst, AV_LOG_INFO,
+               "T11674 get_video_buffer(hw): requested %dx%d, surface %dx%d\n",
+               w, h, frame->width, frame->height);
+        if (frame->width >= w && frame->height >= h) {
+            frame->width  = w;
+            frame->height = h;
+        }
 
         return frame;
     }
